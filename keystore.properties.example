# Copy to keystore.properties (gitignored) and fill in your real storeFile/keyAlias.
# Never commit the copy.
#
# storePassword and keyPassword are NOT stored here. On macOS they're read from
# Keychain at build time; add them once with:
#   security add-generic-password -a storePassword -s SimpleNotes-ReleaseKeystore -w
#   security add-generic-password -a keyPassword -s SimpleNotes-ReleaseKeystore -w
# (each command prompts for the password value interactively via -w)
storeFile=/absolute/path/to/release.keystore
keyAlias=changeit
